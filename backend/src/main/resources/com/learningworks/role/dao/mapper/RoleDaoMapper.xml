<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
  namespace="com.learningworks.role.dao.RoleDao">
  
  <!-- long selectRoleCount(); -->
  <select id="selectRoleCount"
          resultType="_long">
    SELECT COUNT(ROLE_ID)
      FROM "ROLE"
  </select>
  
  <!-- List<RoleVO> selectAllRoles(); -->
  <select id="selectAllRoles"
          resultType="com.learningworks.role.vo.response.RoleVO">
    SELECT ROLE_ID
         , ROLE_DISPLAY_NAME
      FROM "ROLE"
  </select>
  
  <!-- RoleVO selectRoleByRoleId(String roleId); -->
  <select id="selectRoleByRoleId"
          parameterType="string"
          resultType="com.learningworks.role.vo.response.RoleVO">
    SELECT ROLE_ID
         , ROLE_DISPLAY_NAME
      FROM "ROLE"
     WHERE ROLE_ID = #{_parameter}
  </select>
  
  <!-- int insertNewRole(RegistRoleVO registRoleVO); -->
  <insert id="insertNewRole"
          parameterType="com.learningworks.role.vo.request.RegistRoleVO">
    INSERT INTO "ROLE" 
     (ROLE_ID
    , ROLE_DISPLAY_NAME)
    VALUES 
     (#{roleId}
    , #{roleDisplayName})
  </insert>
  
  <!-- int updateRole(String roleId, ModifyRoleVO modifyRoleVO); -->
  <update id="updateRole">
    UPDATE "ROLE"
       SET ROLE_DISPLAY_NAME = #{modifyRoleVO.roleDisplayName} 
     WHERE ROLE_ID = #{roleId}
  </update>

</mapper>