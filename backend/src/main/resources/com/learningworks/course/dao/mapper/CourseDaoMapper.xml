<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learningworks.course.dao.CourseDao">

	<select 
	id="viewCourse" 
	resultType="com.learningworks.course.vo.response.CourseVO">
