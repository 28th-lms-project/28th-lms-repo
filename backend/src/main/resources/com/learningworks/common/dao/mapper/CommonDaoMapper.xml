<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  여러 Mapper 에서 공통으로 사용하는 SQL 조각.
  사용: <include refid="Commons.paginate_header" /> 실제 조회 쿼리(ORDER BY 포함) <include refid="Commons.paginate_footer" />
  파라미터 객체에 pageNo(0부터), listSize 가 있어야 한다. (PaginationVO 상속)
-->
<mapper namespace="Commons">

    <!--
        동명이인 구분 문자 (화면 표시 전용). "USER" 별칭이 U 인 쿼리에서 컬럼으로 사용:
          , <include refid="Commons.nameSuffix" /> AS NAME_SUFFIX
        탈퇴하지 않은 회원 중 이름이 같은 사람이 있으면 등록 순서(가입일 → 아이디)대로 A, B, C ...
        없으면 NULL. 회원 데이터(이름)는 바꾸지 않고 조회 결과에만 붙인다. 회원 식별은 기존대로 USER.ID
    -->
    <sql id="nameSuffix">
        (SELECT CASE
                  WHEN COUNT(*) > 1 THEN
                    CHR(65 + SUM(CASE
                                   WHEN D.CRT_DT <![CDATA[ < ]]> U.CRT_DT
                                     OR (D.CRT_DT = U.CRT_DT AND D.ID <![CDATA[ < ]]> U.ID) THEN 1
                                   ELSE 0
                                 END))
                END
           FROM "USER" D
          WHERE D.NAME = U.NAME
            AND D.DEL_YN = 'N')
    </sql>

    <sql id="paginate_header">
        SELECT *
          FROM (SELECT T.*
                     , ROWNUM AS RNUM
                  FROM (
    </sql>

    <sql id="paginate_footer">
                        ) T
                 WHERE ROWNUM <![CDATA[ <= ]]> (#{pageNo} + 1) * #{listSize})
         WHERE RNUM <![CDATA[ >= ]]> #{pageNo} * #{listSize} + 1
    </sql>
</mapper>