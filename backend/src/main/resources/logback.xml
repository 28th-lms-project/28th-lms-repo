  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [Line:%line] -%kvp- %msg%n</pattern>
    </encoder>
  </appender>
  
  <!-- 
  로그 내용 중 com.zaxxer.hikari.**로 작성되는 모든 로그들의 레벨을 error로 변경.
  불필요한 로그를 제거할 수 있다.
   -->
   <logger name="com.zaxxer.hikari" level="error" />

  <!-- 상담 기본 정보 등록 SQL 의 파라미터 로그(DEBUG)에 평문 연락처가 남지 않도록 이 문장만 INFO -->
   <logger name="com.learningworks.counsel.dao.CounselDao.insertCounsel" level="info" />

  <root level="debug">
    <appender-ref ref="STDOUT" />
<!--     <appender-ref ref="FILE" /> -->
  </root>
</configuration>